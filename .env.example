# Google Places API key, used for [describe usage, e.g. place lookups/autocomplete].
# Get a key from https://console.cloud.google.com/apis/credentials
# Copy this file to .env.local and fill in your real key there (never commit .env.local).
GOOGLE_PLACES_API_KEY=YOUR_KEY_HERE

# Supabase project URL and public anon key. Safe to expose to the browser
# (NEXT_PUBLIC_ prefix) — these identify your project and are meant to be
# used from client-side code, protected by Supabase's row-level security.
# Find both in the Supabase dashboard: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Supabase service role key. Bypasses row-level security entirely — this is
# a full admin key. Server-side use ONLY (API routes / server actions),
# never prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Anthropic API key, used server-side only by the Pricing page's "Assess
# my pricing" tool (app/actions/pricing.ts) to generate an honest,
# tier-based pricing assessment. Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=YOUR_KEY_HERE

# Google OAuth client credentials for the Google Business Profile connect
# flow (Phase 1: lib/googleBusinessProfile.ts, app/api/gbp/*). Create an
# OAuth 2.0 Client ID (type "Web application") in the same Google Cloud
# project as GOOGLE_PLACES_API_KEY, under APIs & Services > Credentials:
# https://console.cloud.google.com/apis/credentials
#
# You must also add an Authorized redirect URI there for every
# environment this app runs in, exactly matching this app's own
# /api/gbp/callback route, e.g.:
#   http://localhost:3000/api/gbp/callback   (local dev)
#   https://your-production-domain/api/gbp/callback
# There's no separate redirect-URI env var — it's derived from the
# incoming request's own origin, so it always matches whatever host
# you're actually running on as long as that host's callback URL is
# registered above.
#
# The actual Business Profile scope (business.manage) needs Google's
# approval before real API calls will succeed — until then, the connect
# flow will still run, but real data reads/writes are Phase 2, not this
# one. Leaving these unset shows an honest "not configured yet" state on
# the connect page instead of a broken redirect.
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET_HERE
